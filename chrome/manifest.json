{
  "manifest_version": 3,
  "name": "Unslop",
  "version": "0.1.0",
  "description": "Replaces Twitch's server-inserted ads with clean video. Opens a few extra background sessions to the same channel to source it.",

  "minimum_chrome_version": "116",

  "icons": {
    "16": "icons/unslop-16.png",
    "32": "icons/unslop-32.png",
    "48": "icons/unslop-48.png",
    "96": "icons/unslop-96.png",
    "128": "icons/unslop-128.png"
  },

  "permissions": ["webRequest", "storage", "offscreen"],

  "host_permissions": [
    "*://*.twitch.tv/*",
    "*://*.ttvnw.net/*",
    "*://*.hls.live-video.net/*",
    "http://127.0.0.1/*"
  ],

  "background": { "service_worker": "sw.js" },

  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Unslop",
    "default_icon": {
      "16": "icons/unslop-16.png",
      "32": "icons/unslop-32.png"
    }
  }
}
